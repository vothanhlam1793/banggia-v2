IMAGE_TAG=latest

WEB_IMAGE=ghcr.io/vothanhlam1793/banggia-web
ADMIN_IMAGE=ghcr.io/vothanhlam1793/banggia-admin
BACKEND_IMAGE=ghcr.io/vothanhlam1793/banggia-backend

WEB_PORT=10200
ADMIN_PORT=10201
BACKEND_PORT=10202

# Used by the standalone web/admin Compose files.
BACKEND_INTERNAL_URL=http://backend.internal:10202

# External MongoDB. Keep this file private on the deployment server.
MONGODB_URI=mongodb://banggia_user:change-me@mongo.example.internal:27017/banggiasi-v3?authSource=admin
JWT_SECRET=change-me-to-a-long-random-secret

# Used only if this email does not already exist in MongoDB.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_PASSWORD=change-me-to-a-long-random-password

KIOTVIET_CLIENT_ID=
KIOTVIET_CLIENT_SECRET=
KIOTVIET_RETAILER=cretasolu
