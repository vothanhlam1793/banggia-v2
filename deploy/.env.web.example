WEB_PORT=10200

# Public API URL used by the browser.
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Public backend origin used by browsers to load product images.
NEXT_PUBLIC_IMAGE_URL=https://api.example.com

# Backend address reachable from the web container.
BACKEND_INTERNAL_URL=http://backend.internal:10202
